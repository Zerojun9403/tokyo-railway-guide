{
  "expo": {
    "name": "Tokyo Railway Guide",
    "slug": "tokyo-railway-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tokyorailwayguide",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerojun.tokyorailwayguide",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.zerojun.tokyorailwayguide",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F9DD16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tokyo Railway Guide는 현재 위치를 기반으로 가까운 역과 이동 정보를 안내하기 위해 위치 정보를 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1012",
          "dark": {
            "backgroundColor": "#0F1012"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}